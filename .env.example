# RazorShield AI — Environment Configuration Template
# Copy to .env for local development. DO NOT commit actual secrets.

ENVIRONMENT=local
POSTGRES_DSN=postgresql://user:password@localhost:5432/razorshield
REDIS_DSN=redis://localhost:6379/0
SQLITE_DB_PATH=razorshield_local.db

AUDIT_HMAC_SECRET=

LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.6-flash
GEMINI_API_KEY=

CHAOS_MODE_ENABLED=false
SIMULATOR_MODE=LOCAL_STANDALONE

VITE_API_BASE_URL=http://localhost:8000
